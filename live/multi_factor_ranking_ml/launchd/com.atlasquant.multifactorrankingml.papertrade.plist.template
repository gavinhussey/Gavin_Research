<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the daily automated paper-trade run. Never committed with
  real values: render {{REPO_ROOT}} to this repo's absolute path and
  install the result at
  ~/Library/LaunchAgents/com.atlasquant.multifactorrankingml.papertrade.plist,
  then launchctl load it. Contains no credentials; the wrapper script
  it invokes sources ~/.atlas-quant/secrets.env itself. Real, order
  submitting path: require_market_open makes a wrong timezone Hour
  harmless (a skipped day), not dangerous, but double check Hour/Minute
  match this machine's local time relative to the 9:30 ET open before
  loading.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atlasquant.multifactorrankingml.papertrade</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{REPO_ROOT}}/live/multi_factor_ranking_ml/run_paper_trade.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{REPO_ROOT}}/data/logs/multi_factor_ranking_ml/paper_trade.log</string>
    <key>StandardErrorPath</key>
    <string>{{REPO_ROOT}}/data/logs/multi_factor_ranking_ml/paper_trade.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
